{
  "manifest_version": 3,
  "name": "AutoAD",
  "version": "0.2.1",
  "description": "Gemini-generated audio description for YouTube, spoken in the video's own silent gaps.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_title": "AutoAD settings",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/gemini.js",
        "src/settings.js",
        "src/cache.js",
        "src/coordinator.js",
        "src/panel.js",
        "src/live.js",
        "src/audio.js",
        "src/player.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
